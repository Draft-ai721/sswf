# Values are configured in Sites. Never commit actual keys.
AI_PROVIDER=deepseek
AI_DAILY_LIMIT=10
# Secret: Base64-encoded 32 random bytes. Preserve existing value; rotation requires migration.
AI_SECRET_ENCRYPTION_KEY=
# Optional shared service, disabled unless an allowlist is also configured.
DEEPSEEK_API_KEY=
AI_ALLOWED_EMAILS=
AI_MODEL=deepseek-flash
# Railway / local Node runtime (secrets must remain outside Git)
PORT=3000
DATA_DIR=/data
# PUBLIC_URL=https://your-service.up.railway.app
# BOOTSTRAP_TOKEN=configure-a-random-secret-in-Railway-Variables
# AI_SECRET_ENCRYPTION_KEY is generated and persisted on the data volume if omitted.
